# Copy this file to .env to change a setting. Every line is optional.

# Whisper model: tiny, base, small, medium, large-v3, large-v3-turbo,
# or a path to a local faster-whisper model folder.
#WHISPER_MODEL=large-v3-turbo

# Spoken language as an ISO code (en, de, fr, ...). Leave empty to auto-detect.
#WHISPER_LANGUAGE=

# Words Whisper keeps misspelling (names, product terms), comma-separated.
#WHISPER_VOCAB=Kubernetes, PostgreSQL, Anya

# Keep the model loaded all the time (default 1): it loads when the app starts,
# so every dictation is transcribed at once. Set 0 on PCs short on memory: the
# model then loads when you press the hotkey and is released after
# WHISPER_IDLE_TIMEOUT seconds without a dictation.
#WHISPER_KEEP_LOADED=1
#WHISPER_IDLE_TIMEOUT=90

# Where downloaded models are stored (default: models\ next to main.py).
#MODELS_DIR=

# Microphone sample rate. Whisper works at 16000 internally.
#SAMPLE_RATE=16000